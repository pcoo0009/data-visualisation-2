{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Simple waffle chart: 100 squares, each 1% of threatened species. The CSV supplies the number of squares per group.",
 "width": {
  "step": 52
 },
 "height": {
  "step": 52
 },
 "padding": {
  "left": 10,
  "right": 10,
  "top": 10,
  "bottom": 60
 },
 "data": {
  "url": "data/threatened-species-by-group.csv",
  "format": {
   "type": "csv",
   "parse": {
    "species": "number",
    "squares": "number"
   }
  }
 },
 "transform": [
  {
   "calculate": "datum.group + ' (' + datum.species + ')'",
   "as": "legendLabel"
  },
  {
   "calculate": "sequence(datum.squares)",
   "as": "sq"
  },
  {
   "flatten": [
    "sq"
   ]
  },
  {
   "window": [
    {
     "op": "row_number",
     "as": "idx"
    }
   ]
  },
  {
   "calculate": "floor((datum.idx - 1) / 10) % 2 == 0 ? (datum.idx - 1) % 10 : 9 - (datum.idx - 1) % 10",
   "as": "col"
  },
  {
   "calculate": "floor((datum.idx - 1) / 10)",
   "as": "row"
  }
 ],
 "mark": {
  "type": "rect",
  "stroke": "white",
  "strokeWidth": 4,
  "cornerRadius": 3
 },
 "encoding": {
  "x": {
   "field": "col",
   "type": "ordinal",
   "axis": null
  },
  "y": {
   "field": "row",
   "type": "ordinal",
   "axis": null
  },
  "color": {
   "field": "legendLabel",
   "type": "nominal",
   "sort": null,
   "scale": {
    "domain": [
     "Plants (178)",
     "Mammals (92)",
     "Birds (73)",
     "Amphibians (28)",
     "Reptiles (24)"
    ],
    "range": [
     "#009E73",
     "#E69F00",
     "#0072B2",
     "#CC79A7",
     "#56B4E9"
    ]
   },
   "legend": {
    "title": "Group (number of species)",
    "orient": "none",
    "direction": "horizontal",
    "columns": 5,
    "legendX": {
     "expr": "width/2 - 245"
    },
    "legendY": {
     "expr": "height + 22"
    },
    "symbolType": "square",
    "symbolSize": 100,
    "labelFontSize": 11,
    "titleFontSize": 12,
    "titleFontWeight": "bold",
    "titleOrient": "top",
    "titleAnchor": "middle",
    "titlePadding": 8,
    "labelLimit": 100,
    "columnPadding": 6,
    "rowPadding": 6,
    "titleLimit": 300
   }
  },
  "tooltip": [
   {
    "field": "group",
    "type": "nominal",
    "title": "Group"
   },
   {
    "field": "species",
    "type": "quantitative",
    "title": "Threatened species"
   },
   {
    "field": "squares",
    "type": "quantitative",
    "title": "Share of all (%)"
   }
  ]
 },
 "config": {
  "view": {
   "stroke": null
  },
  "font": "Public Sans, Helvetica Neue, Arial, sans-serif",
  "axis": {
   "labelFontSize": 11,
   "titleFontSize": 12,
   "titleFontWeight": "normal",
   "labelColor": "#6B7280",
   "titleColor": "#6B7280"
  },
  "legend": {
   "labelFontSize": 11,
   "titleFontSize": 12,
   "titleFontWeight": "bold",
   "labelColor": "#374151",
   "titleColor": "#374151"
  }
 }
}