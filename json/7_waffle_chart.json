{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Simple waffle chart: 100 squares, each 1% of threatened species. The CSV supplies the number of squares per group.",
  "width": {"step": 38},
  "height": {"step": 38},
  "padding": {"left": 10, "right": 20, "top": 10, "bottom": 10},
  "title": {
    "text": "Threatened species with monitoring data, by group",
    "subtitle": [
      "Each square is 1% of the threatened species that have monitoring data in the Threatened Species Index.",
      "This counts how many different species, not how many individual animals or plants are left."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitleColor": "#6B7280",
    "offset": 16
  },
  "data": {
    "url": "https://pcoo0009.github.io/data-visualisation-2/data/threatened-species-by-group.csv",
    "format": {"type": "csv", "parse": {"species": "number", "squares": "number"}}
  },
  "transform": [
    {"calculate": "datum.group + ' (' + datum.species + ')'", "as": "legendLabel"},
    {"calculate": "sequence(datum.squares)", "as": "sq"},
    {"flatten": ["sq"]},
    {"window": [{"op": "row_number", "as": "idx"}]},
    {"calculate": "(datum.idx - 1) % 10", "as": "col"},
    {"calculate": "floor((datum.idx - 1) / 10)", "as": "row"}
  ],
  "mark": {"type": "rect", "stroke": "white", "strokeWidth": 4, "cornerRadius": 3},
  "encoding": {
    "x": {"field": "col", "type": "ordinal", "axis": null},
    "y": {"field": "row", "type": "ordinal", "axis": null},
    "color": {
      "field": "legendLabel",
      "type": "nominal",
      "sort": null,
      "scale": {"range": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300"]},
      "legend": {
        "title": "Group (number of species)",
        "orient": "right",
        "symbolType": "square",
        "symbolSize": 260,
        "labelFontSize": 12,
        "titleFontSize": 12,
        "labelLimit": 260,
        "titleLimit": 320,
        "rowPadding": 6
      }
    },
    "tooltip": [
      {"field": "group", "type": "nominal", "title": "Group"},
      {"field": "species", "type": "quantitative", "title": "Threatened species"},
      {"field": "squares", "type": "quantitative", "title": "Share of all (%)"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "font": "Helvetica Neue, Arial, sans-serif"
  }
}
