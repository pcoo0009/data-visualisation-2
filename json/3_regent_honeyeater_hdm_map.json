{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Map of Victoria: habitat model for the Regent Honeyeater with recorded sightings on top.",
 "vconcat": [
  {
   "width": 410,
   "height": 270,
   "projection": {
    "type": "conicConformal",
    "rotate": [
     -145,
     0
    ],
    "parallels": [
     -36,
     -38
    ]
   },
   "layer": [
    {
     "description": "Victoria outline",
     "data": {
      "url": "data/state_map_simplified.json",
      "format": {
       "type": "topojson",
       "feature": "STE_2021_AUST_GDA2020"
      }
     },
     "transform": [
      {
       "filter": "datum.properties.STE_NAME21 == 'Victoria'"
      }
     ],
     "mark": {
      "type": "geoshape",
      "fill": "#F1F3F5",
      "stroke": "#9AA3AF",
      "strokeWidth": 1
     }
    },
    {
     "description": "Habitat model: one square per grid cell (about 750 m)",
     "data": {
      "url": "data/hdm-clean.csv",
      "format": {
       "type": "csv",
       "parse": {
        "lon": "number",
        "lat": "number",
        "value": "number"
       }
      }
     },
     "transform": [
      {
       "calculate": "datum.lon - 0.0044",
       "as": "lon0"
      },
      {
       "calculate": "datum.lon + 0.0044",
       "as": "lon1"
      },
      {
       "calculate": "datum.lat - 0.0034",
       "as": "lat0"
      },
      {
       "calculate": "datum.lat + 0.0034",
       "as": "lat1"
      }
     ],
     "mark": {
      "type": "rect",
      "opacity": 0.9
     },
     "encoding": {
      "longitude": {
       "field": "lon0",
       "type": "quantitative"
      },
      "longitude2": {
       "field": "lon1"
      },
      "latitude": {
       "field": "lat0",
       "type": "quantitative"
      },
      "latitude2": {
       "field": "lat1"
      },
      "color": {
       "field": "value",
       "type": "quantitative",
       "title": "Habitat model value",
       "scale": {
        "scheme": "greens",
        "domain": [
         0,
         33
        ]
       },
       "legend": {
        "title": "Predicted habitat suitability",
        "orient": "none",
        "direction": "horizontal",
        "legendX": 55,
        "legendY": 284,
        "gradientLength": 300,
        "gradientThickness": 12,
        "titleOrient": "top",
        "titleAnchor": "middle",
        "titleFontSize": 12,
        "titleFontWeight": "bold",
        "titlePadding": 6,
        "labelFontSize": 11,
        "labelOverlap": true,
        "values": [
         0,
         10,
         20,
         30
        ]
       }
      }
     }
    },
    {
     "description": "leader",
     "data": {
      "values": [
       {
        "lon": 142.3,
        "lat": -36.55,
        "o": 0
       },
       {
        "lon": 143.05,
        "lat": -36.95,
        "o": 1
       }
      ]
     },
     "mark": {
      "type": "line",
      "color": "#374151",
      "strokeWidth": 1
     },
     "encoding": {
      "longitude": {
       "field": "lon",
       "type": "quantitative"
      },
      "latitude": {
       "field": "lat",
       "type": "quantitative"
      },
      "order": {
       "field": "o",
       "type": "quantitative"
      }
     }
    },
    {
     "description": "dot",
     "data": {
      "values": [
       {
        "lon": 143.05,
        "lat": -36.95,
        "o": 1
       }
      ]
     },
     "mark": {
      "type": "circle",
      "color": "#374151",
      "size": 30,
      "opacity": 1
     },
     "encoding": {
      "longitude": {
       "field": "lon",
       "type": "quantitative"
      },
      "latitude": {
       "field": "lat",
       "type": "quantitative"
      }
     }
    },
    {
     "description": "text",
     "data": {
      "values": [
       {
        "lon": 141.3,
        "lat": -35.55
       }
      ]
     },
     "mark": {
      "type": "text",
      "align": "left",
      "baseline": "top",
      "fontSize": 11,
      "color": "#374151",
      "lineHeight": 13,
      "text": [
       "The green patches",
       "represent modelled",
       "suitable habitat for",
       "the species"
      ]
     },
     "encoding": {
      "longitude": {
       "field": "lon",
       "type": "quantitative"
      },
      "latitude": {
       "field": "lat",
       "type": "quantitative"
      }
     }
    },
    {
     "description": "leader",
     "data": {
      "values": [
       {
        "lon": 146.2,
        "lat": -34.75,
        "o": 0
       },
       {
        "lon": 144.32,
        "lat": -36.77,
        "o": 1
       }
      ]
     },
     "mark": {
      "type": "line",
      "color": "#374151",
      "strokeWidth": 1
     },
     "encoding": {
      "longitude": {
       "field": "lon",
       "type": "quantitative"
      },
      "latitude": {
       "field": "lat",
       "type": "quantitative"
      },
      "order": {
       "field": "o",
       "type": "quantitative"
      }
     }
    },
    {
     "description": "dot",
     "data": {
      "values": [
       {
        "lon": 144.32,
        "lat": -36.77,
        "o": 1
       }
      ]
     },
     "mark": {
      "type": "circle",
      "color": "#374151",
      "size": 30,
      "opacity": 1
     },
     "encoding": {
      "longitude": {
       "field": "lon",
       "type": "quantitative"
      },
      "latitude": {
       "field": "lat",
       "type": "quantitative"
      }
     }
    },
    {
     "description": "text",
     "data": {
      "values": [
       {
        "lon": 147.2,
        "lat": -33.9
       }
      ]
     },
     "mark": {
      "type": "text",
      "align": "center",
      "baseline": "top",
      "fontSize": 11,
      "color": "#374151",
      "lineHeight": 13,
      "text": [
       "Past 2010, the Regent",
       "Honeyeater has never been",
       "spotted further west than",
       "Bendigo"
      ]
     },
     "encoding": {
      "longitude": {
       "field": "lon",
       "type": "quantitative"
      },
      "latitude": {
       "field": "lat",
       "type": "quantitative"
      }
     }
    },
    {
     "description": "Recorded sightings",
     "data": {
      "url": "data/regent-honeyeater-vic.csv",
      "format": {
       "type": "csv",
       "parse": {
        "lon": "number",
        "lat": "number",
        "year": "number"
       }
      }
     },
     "mark": {
      "type": "circle",
      "size": 28,
      "fill": "#0B3D91",
      "fillOpacity": 0.85,
      "stroke": "white",
      "strokeWidth": 0.6
     },
     "encoding": {
      "longitude": {
       "field": "lon",
       "type": "quantitative"
      },
      "latitude": {
       "field": "lat",
       "type": "quantitative"
      },
      "tooltip": [
       {
        "field": "year",
        "type": "quantitative",
        "title": "Year recorded",
        "format": "d"
       }
      ]
     },
     "transform": [
      {
       "filter": {
        "param": "yearBrush"
       }
      }
     ]
    }
   ]
  },
  {
   "width": 410,
   "height": 70,
   "title": {
    "text": [
     "Sightings recorded each year",
     "(drag to filter the map)"
    ],
    "anchor": "middle",
    "fontSize": 12,
    "color": "#6B7280"
   },
   "data": {
    "url": "data/regent-honeyeater-vic.csv",
    "format": {
     "type": "csv",
     "parse": {
      "year": "number"
     }
    }
   },
   "params": [
    {
     "name": "yearBrush",
     "select": {
      "type": "interval",
      "encodings": [
       "x"
      ]
     }
    }
   ],
   "mark": {
    "type": "bar",
    "color": "#999",
    "clip": true
   },
   "encoding": {
    "x": {
     "field": "year",
     "type": "quantitative",
     "title": "Year of record",
     "axis": {
      "format": "d"
     },
     "scale": {
      "domain": [
       1970,
       2025
      ],
      "nice": false
     }
    },
    "y": {
     "aggregate": "count",
     "type": "quantitative",
     "title": "Records",
     "axis": {
      "tickCount": 2
     }
    }
   }
  }
 ],
 "config": {
  "view": {
   "stroke": null
  },
  "font": "Public Sans, Helvetica Neue, Arial, sans-serif",
  "axis": {
   "labelFontSize": 11,
   "titleFontSize": 12,
   "titleFontWeight": "normal",
   "labelColor": "#6B7280",
   "titleColor": "#6B7280"
  },
  "legend": {
   "labelFontSize": 11,
   "titleFontSize": 12,
   "titleFontWeight": "bold",
   "labelColor": "#374151",
   "titleColor": "#374151"
  }
 },
 "spacing": 75,
 "padding": {
  "top": 5,
  "left": 5,
  "right": 5,
  "bottom": 10
 }
}