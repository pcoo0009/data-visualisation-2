{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": "container",
 "height": 640,
 "data": {
  "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
  "format": {
   "type": "topojson",
   "feature": "ne_110m_admin_0_countries"
  }
 },
 "params": [
  {
   "name": "group",
   "value": "Total",
   "bind": {
    "input": "select",
    "options": [
     "Mammals",
     "Birds",
     "Reptiles",
     "Amphibians",
     "Fishes",
     "Molluscs",
     "Other Inverts",
     "Plants",
     "Fungi",
     "Chromists",
     "Total"
    ],
    "name": "Species group: "
   }
  }
 ],
 "projection": {
  "type": "equalEarth"
 },
 "transform": [
  {
   "calculate": "({SAH:'ESH',SDS:'SSD',PSX:'PSE'})[datum.properties.ADM0_A3] || datum.properties.ADM0_A3",
   "as": "iso3"
  },
  {
   "lookup": "iso3",
   "from": {
    "data": {
     "url": "https://pcoo0009.github.io/data-visualisation-2/data/threatened-species-by-country.csv"
    },
    "key": "iso3",
    "fields": [
     "Name",
     "Mammals",
     "Birds",
     "Reptiles",
     "Amphibians",
     "Fishes",
     "Molluscs",
     "Other Inverts",
     "Plants",
     "Fungi",
     "Chromists",
     "Total"
    ]
   }
  },
  {
   "calculate": "datum.Name == null ? null : toNumber(datum[group])",
   "as": "count"
  }
 ],
 "config": {
  "view": {
   "stroke": null
  }
 },
 "autosize": {
  "type": "fit",
  "contains": "padding"
 },
 "layer": [
  {
   "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.4
   },
   "encoding": {
    "color": {
     "field": "count",
     "type": "quantitative",
     "scale": {
      "type": "sqrt",
      "scheme": "yelloworangered"
     },
     "legend": {
      "title": "Threatened species",
      "orient": "none",
      "direction": "horizontal",
      "legendX": {
       "expr": "width/2 - 150"
      },
      "legendY": {
       "expr": "height + 14"
      },
      "gradientLength": 300,
      "gradientThickness": 12,
      "titleOrient": "top",
      "titleAnchor": "middle",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titlePadding": 6,
      "labelFontSize": 11,
      "labelOverlap": true,
      "tickCount": 5,
      "format": ",.0f"
     },
     "condition": {
      "test": "datum.count == null",
      "value": "#dfe3e0"
     }
    },
    "tooltip": [
     {
      "field": "properties.NAME",
      "title": "Map name"
     },
     {
      "field": "Name",
      "title": "Country"
     },
     {
      "field": "count",
      "title": "Threatened species",
      "format": ","
     }
    ]
   }
  },
  {
   "transform": [
    {
     "filter": "indexof(['AUS', 'BRA', 'CHN', 'COL', 'COD', 'ECU', 'IND', 'IDN', 'MDG', 'MYS', 'MEX', 'PNG', 'PER', 'PHL', 'ZAF', 'USA', 'VEN'], datum.iso3) >= 0"
    }
   ],
   "mark": {
    "type": "geoshape",
    "fill": null,
    "stroke": "#1F2937",
    "strokeWidth": 1.5
   }
  }
 ],
 "padding": {
  "top": 5,
  "left": 5,
  "right": 5,
  "bottom": 70
 }
}