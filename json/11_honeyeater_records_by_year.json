{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Number of Regent Honeyeater sighting records per year, 1980 to 2024.",
 "width": "container",
 "height": 320,
 "autosize": {
  "type": "fit-x",
  "contains": "padding"
 },
 "padding": {
  "top": 12,
  "left": 12,
  "right": 20,
  "bottom": 5
 },
 "data": {
  "url": "https://pcoo0009.github.io/data-visualisation-2/data/critically-endangered-species-occurrences.csv",
  "format": {
   "type": "csv",
   "parse": {
    "Year": "number"
   }
  }
 },
 "transform": [
  {
   "filter": "datum.Species == 'Regent Honeyeater' && isValid(datum.Year) && datum.Year >= 1980 && datum.Year <= 2024"
  },
  {
   "aggregate": [
    {
     "op": "count",
     "as": "records"
    }
   ],
   "groupby": [
    "Year"
   ]
  }
 ],
 "mark": {
  "type": "line",
  "color": "#E4572E",
  "strokeWidth": 2.5,
  "point": {
   "filled": true,
   "size": 50,
   "color": "#E4572E"
  }
 },
 "encoding": {
  "x": {
   "field": "Year",
   "type": "quantitative",
   "title": "Year",
   "scale": {
    "domain": [
     1980,
     2024
    ]
   },
   "axis": {
    "format": "d",
    "tickMinStep": 5,
    "labelAngle": 0,
    "grid": false,
    "domain": false,
    "ticks": false
   }
  },
  "y": {
   "field": "records",
   "type": "quantitative",
   "title": "Sighting records per year",
   "axis": {
    "gridColor": "#EEF0F3",
    "domain": false,
    "ticks": false
   }
  },
  "tooltip": [
   {
    "field": "Year",
    "type": "quantitative",
    "title": "Year",
    "format": "d"
   },
   {
    "field": "records",
    "type": "quantitative",
    "title": "Records"
   }
  ]
 },
 "config": {
  "view": {
   "stroke": null
  },
  "font": "Helvetica Neue, Arial, sans-serif"
 },
 "background": "#fffdf9"
}