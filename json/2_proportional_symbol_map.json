{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": "container",
 "height": 700,
 "params": [
  {
   "name": "status",
   "value": "All",
   "bind": {
    "input": "select",
    "name": "Threatened status: ",
    "options": [
     "All",
     "Critically Endangered",
     "Endangered",
     "Vulnerable",
     "Extinct",
     "Extinct in the wild",
     "Conservation Dependent"
    ]
   }
  }
 ],
 "projection": {
  "type": "conicEqualArea",
  "rotate": [
   -132,
   0
  ],
  "parallels": [
   -18,
   -36
  ]
 },
 "layer": [
  {
   "data": {
    "url": "data/state_map_simplified.json",
    "format": {
     "type": "topojson",
     "feature": "STE_2021_AUST_GDA2020"
    }
   },
   "transform": [
    {
     "filter": "indexof(['New South Wales','Victoria','Queensland','South Australia','Western Australia','Tasmania','Northern Territory','Australian Capital Territory'], datum.properties.STE_NAME21) >= 0"
    }
   ],
   "mark": {
    "type": "geoshape",
    "fill": "#e8e8e8",
    "stroke": "white",
    "strokeWidth": 0.8
   }
  },
  {
   "data": {
    "url": "data/threatened-species-by-state.csv",
    "format": {
     "type": "csv",
     "parse": {
      "Number of Species": "number"
     }
    }
   },
   "transform": [
    {
     "filter": "status == 'All' || datum['Threatened Status'] == status"
    },
    {
     "calculate": "{'ACT':'Australian Capital Territory','NSW':'New South Wales','NT':'Northern Territory','QLD':'Queensland','SA':'South Australia','TAS':'Tasmania','VIC':'Victoria','WA':'Western Australia'}[datum.State]",
     "as": "stateName"
    },
    {
     "filter": "isValid(datum.stateName)"
    },
    {
     "aggregate": [
      {
       "op": "sum",
       "field": "Number of Species",
       "as": "totalSpecies"
      }
     ],
     "groupby": [
      "State",
      "stateName"
     ]
    },
    {
     "calculate": "{'ACT':149.4,'NSW':146.8,'NT':133.5,'QLD':144.5,'SA':135.5,'TAS':146.6,'VIC':144.3,'WA':122.5}[datum.State]",
     "as": "lon"
    },
    {
     "calculate": "{'ACT':-35.5,'NSW':-32.2,'NT':-19.5,'QLD':-22.5,'SA':-30.0,'TAS':-42.0,'VIC':-36.9,'WA':-25.5}[datum.State]",
     "as": "lat"
    }
   ],
   "mark": {
    "type": "circle",
    "fill": "#d95f0e",
    "fillOpacity": 0.65,
    "stroke": "#7f2704",
    "strokeWidth": 1
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "size": {
     "field": "totalSpecies",
     "type": "quantitative",
     "title": "Number of species",
     "scale": {
      "type": "linear",
      "zero": true,
      "range": [
       0,
       5000
      ]
     },
     "legend": null
    },
    "order": {
     "field": "totalSpecies",
     "sort": "descending"
    },
    "tooltip": [
     {
      "field": "stateName",
      "type": "nominal",
      "title": "State / territory"
     },
     {
      "field": "totalSpecies",
      "type": "quantitative",
      "title": "Threatened species",
      "format": ","
     }
    ]
   }
  },
  {
   "data": {
    "url": "data/threatened-species-by-state.csv",
    "format": {
     "type": "csv",
     "parse": {
      "Number of Species": "number"
     }
    }
   },
   "transform": [
    {
     "filter": "status == 'All' || datum['Threatened Status'] == status"
    },
    {
     "calculate": "{'ACT':'Australian Capital Territory','NSW':'New South Wales','NT':'Northern Territory','QLD':'Queensland','SA':'South Australia','TAS':'Tasmania','VIC':'Victoria','WA':'Western Australia'}[datum.State]",
     "as": "stateName"
    },
    {
     "filter": "isValid(datum.stateName)"
    },
    {
     "aggregate": [
      {
       "op": "sum",
       "field": "Number of Species",
       "as": "totalSpecies"
      }
     ],
     "groupby": [
      "State",
      "stateName"
     ]
    },
    {
     "filter": "datum.totalSpecies > 0"
    },
    {
     "aggregate": [
      {
       "op": "max",
       "field": "totalSpecies",
       "as": "vmax"
      },
      {
       "op": "min",
       "field": "totalSpecies",
       "as": "vmin"
      }
     ]
    },
    {
     "calculate": "floor(datum.vmax / pow(10, floor(log(datum.vmax)/LN10) - 1)) * pow(10, floor(log(datum.vmax)/LN10) - 1)",
     "as": "a"
    },
    {
     "calculate": "floor(datum.vmin / pow(10, floor(log(datum.vmin)/LN10) - 1)) * pow(10, floor(log(datum.vmin)/LN10) - 1)",
     "as": "c"
    },
    {
     "calculate": "max(datum.c, floor(sqrt(datum.a * datum.c)))",
     "as": "b"
    },
    {
     "fold": [
      "a",
      "b",
      "c"
     ],
     "as": [
      "k",
      "value"
     ]
    },
    {
     "filter": "isFinite(datum.value) && datum.value > 0"
    },
    {
     "aggregate": [
      {
       "op": "min",
       "field": "vmax",
       "as": "vmax"
      }
     ],
     "groupby": [
      "value"
     ]
    },
    {
     "window": [
      {
       "op": "row_number",
       "as": "i"
      }
     ],
     "sort": [
      {
       "field": "value",
       "order": "ascending"
      }
     ]
    },
    {
     "calculate": "2 * sqrt(5000 / PI * datum.value / datum.vmax)",
     "as": "dia"
    },
    {
     "calculate": "datum.dia + 62",
     "as": "w"
    },
    {
     "window": [
      {
       "op": "sum",
       "field": "w",
       "as": "cum"
      }
     ],
     "sort": [
      {
       "field": "value",
       "order": "ascending"
      }
     ],
     "frame": [
      null,
      0
     ]
    },
    {
     "calculate": "(width/2 - 0.13*min(width, height*1.065) - 100) + datum.cum - datum.w + datum.dia/2",
     "as": "cx"
    },
    {
     "calculate": "datum.cx + datum.dia/2 + 6",
     "as": "lx"
    },
    {
     "calculate": "(height/2 + 0.2*min(width, height*1.065) + 25) + 62",
     "as": "cy"
    }
   ],
   "mark": {
    "type": "circle",
    "fill": "#d95f0e",
    "fillOpacity": 0.65,
    "stroke": "#7f2704",
    "strokeWidth": 1
   },
   "encoding": {
    "x": {
     "field": "cx",
     "type": "quantitative",
     "scale": null
    },
    "y": {
     "field": "cy",
     "type": "quantitative",
     "scale": null
    },
    "size": {
     "field": "value",
     "type": "quantitative",
     "legend": null
    }
   }
  },
  {
   "data": {
    "url": "data/threatened-species-by-state.csv",
    "format": {
     "type": "csv",
     "parse": {
      "Number of Species": "number"
     }
    }
   },
   "transform": [
    {
     "filter": "status == 'All' || datum['Threatened Status'] == status"
    },
    {
     "calculate": "{'ACT':'Australian Capital Territory','NSW':'New South Wales','NT':'Northern Territory','QLD':'Queensland','SA':'South Australia','TAS':'Tasmania','VIC':'Victoria','WA':'Western Australia'}[datum.State]",
     "as": "stateName"
    },
    {
     "filter": "isValid(datum.stateName)"
    },
    {
     "aggregate": [
      {
       "op": "sum",
       "field": "Number of Species",
       "as": "totalSpecies"
      }
     ],
     "groupby": [
      "State",
      "stateName"
     ]
    },
    {
     "filter": "datum.totalSpecies > 0"
    },
    {
     "aggregate": [
      {
       "op": "max",
       "field": "totalSpecies",
       "as": "vmax"
      },
      {
       "op": "min",
       "field": "totalSpecies",
       "as": "vmin"
      }
     ]
    },
    {
     "calculate": "floor(datum.vmax / pow(10, floor(log(datum.vmax)/LN10) - 1)) * pow(10, floor(log(datum.vmax)/LN10) - 1)",
     "as": "a"
    },
    {
     "calculate": "floor(datum.vmin / pow(10, floor(log(datum.vmin)/LN10) - 1)) * pow(10, floor(log(datum.vmin)/LN10) - 1)",
     "as": "c"
    },
    {
     "calculate": "max(datum.c, floor(sqrt(datum.a * datum.c)))",
     "as": "b"
    },
    {
     "fold": [
      "a",
      "b",
      "c"
     ],
     "as": [
      "k",
      "value"
     ]
    },
    {
     "filter": "isFinite(datum.value) && datum.value > 0"
    },
    {
     "aggregate": [
      {
       "op": "min",
       "field": "vmax",
       "as": "vmax"
      }
     ],
     "groupby": [
      "value"
     ]
    },
    {
     "window": [
      {
       "op": "row_number",
       "as": "i"
      }
     ],
     "sort": [
      {
       "field": "value",
       "order": "ascending"
      }
     ]
    },
    {
     "calculate": "2 * sqrt(5000 / PI * datum.value / datum.vmax)",
     "as": "dia"
    },
    {
     "calculate": "datum.dia + 62",
     "as": "w"
    },
    {
     "window": [
      {
       "op": "sum",
       "field": "w",
       "as": "cum"
      }
     ],
     "sort": [
      {
       "field": "value",
       "order": "ascending"
      }
     ],
     "frame": [
      null,
      0
     ]
    },
    {
     "calculate": "(width/2 - 0.13*min(width, height*1.065) - 100) + datum.cum - datum.w + datum.dia/2",
     "as": "cx"
    },
    {
     "calculate": "datum.cx + datum.dia/2 + 6",
     "as": "lx"
    },
    {
     "calculate": "(height/2 + 0.2*min(width, height*1.065) + 25) + 62",
     "as": "cy"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "baseline": "middle",
    "fontSize": 11
   },
   "encoding": {
    "x": {
     "field": "lx",
     "type": "quantitative",
     "scale": null
    },
    "y": {
     "field": "cy",
     "type": "quantitative",
     "scale": null
    },
    "text": {
     "field": "value",
     "type": "quantitative",
     "format": "d"
    }
   }
  },
  {
   "data": {
    "values": [
     {
      "t": "Number of species"
     }
    ]
   },
   "mark": {
    "type": "text",
    "align": "left",
    "baseline": "top",
    "fontSize": 12,
    "fontWeight": "bold"
   },
   "encoding": {
    "x": {
     "value": {
      "expr": "(width/2 - 0.13*min(width, height*1.065) - 100)"
     }
    },
    "y": {
     "value": {
      "expr": "(height/2 + 0.2*min(width, height*1.065) + 25)"
     }
    },
    "text": {
     "field": "t",
     "type": "nominal"
    }
   }
  }
 ],
 "autosize": {
  "type": "fit",
  "contains": "padding"
 },
 "padding": {
  "top": 5,
  "left": 5,
  "right": 5,
  "bottom": 5
 }
}