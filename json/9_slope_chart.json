{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": "container",
 "height": 400,
 "data": {
  "url": "https://pcoo0009.github.io/data-visualisation-2/data/TSX_values_by_state.csv",
  "format": {
   "type": "csv",
   "parse": {
    "year": "number",
    "value": "number"
   }
  }
 },
 "transform": [
  {
   "filter": "datum.code != 'ACT'"
  }
 ],
 "config": {
  "view": {
   "stroke": null
  },
  "axis": {
   "domain": false,
   "ticks": false,
   "gridColor": "#EEF0F3"
  }
 },
 "autosize": {
  "type": "fit-x",
  "contains": "padding"
 },
 "padding": {
  "top": 5,
  "left": 5,
  "right": 5,
  "bottom": 125
 },
 "encoding": {
  "x": {
   "field": "year",
   "type": "quantitative",
   "title": "Year",
   "axis": {
    "labelAngle": 0,
    "values": [
     2000,
     2022
    ],
    "format": "d",
    "grid": false
   },
   "scale": {
    "domain": [
     1998,
     2024
    ]
   }
  },
  "y": {
   "field": "value",
   "type": "quantitative",
   "title": "Threatened Species Index",
   "scale": {
    "zero": false
   }
  },
  "color": {
   "field": "state",
   "type": "nominal",
   "title": null,
   "legend": {
    "title": null,
    "orient": "none",
    "direction": "horizontal",
    "columns": 2,
    "legendX": {
     "expr": "width/2 - 170"
    },
    "legendY": {
     "expr": "height + 50"
    },
    "symbolType": "stroke",
    "symbolStrokeWidth": 4,
    "labelFontSize": 12,
    "columnPadding": 18,
    "rowPadding": 6,
    "labelLimit": 200,
    "symbolSize": 200
   }
  }
 },
 "layer": [
  {
   "mark": {
    "type": "line",
    "strokeWidth": 2
   },
   "encoding": {
    "tooltip": [
     {
      "field": "state",
      "title": "State"
     }
    ]
   }
  },
  {
   "description": "Invisible wide segment between the two years so the whole line shows the state name on hover",
   "transform": [
    {
     "pivot": "year",
     "value": "value",
     "groupby": [
      "state"
     ]
    },
    {
     "calculate": "2000",
     "as": "x0"
    },
    {
     "calculate": "2022",
     "as": "x1"
    }
   ],
   "mark": {
    "type": "rule",
    "strokeWidth": 14,
    "opacity": 0.01
   },
   "encoding": {
    "x": {
     "field": "x0",
     "type": "quantitative"
    },
    "x2": {
     "field": "x1"
    },
    "y": {
     "field": "2000",
     "type": "quantitative"
    },
    "y2": {
     "field": "2022"
    },
    "color": {
     "value": "#000"
    },
    "tooltip": [
     {
      "field": "state",
      "title": "State"
     }
    ]
   }
  },
  {
   "mark": {
    "type": "point",
    "filled": true,
    "size": 60,
    "opacity": 1
   },
   "encoding": {
    "tooltip": [
     {
      "field": "state",
      "title": "State"
     },
     {
      "field": "year",
      "title": "Year"
     },
     {
      "field": "value",
      "title": "Index",
      "format": ".2f"
     }
    ]
   }
  }
 ]
}