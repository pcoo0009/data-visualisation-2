{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Heatmap: number of threatened animal species in each status category, by state and territory.",
 "width": "container",
 "height": {
  "step": 32
 },
 "padding": {
  "top": 10,
  "left": 5,
  "right": 15,
  "bottom": 70
 },
 "data": {
  "url": "data/threatened-species-by-state.csv"
 },
 "transform": [
  {
   "filter": "datum.Kingdom == 'Animalia'"
  },
  {
   "filter": "indexof(['NSW','VIC','QLD','WA','SA','TAS','ACT','NT'], datum.State) >= 0"
  },
  {
   "calculate": "datum['Threatened Status']",
   "as": "Status"
  },
  {
   "calculate": "toNumber(datum['Number of Species'])",
   "as": "Count"
  },
  {
   "lookup": "State",
   "from": {
    "data": {
     "values": [
      {
       "code": "NSW",
       "name": "New South Wales"
      },
      {
       "code": "VIC",
       "name": "Victoria"
      },
      {
       "code": "QLD",
       "name": "Queensland"
      },
      {
       "code": "WA",
       "name": "Western Australia"
      },
      {
       "code": "SA",
       "name": "South Australia"
      },
      {
       "code": "TAS",
       "name": "Tasmania"
      },
      {
       "code": "ACT",
       "name": "Australian Capital Territory"
      },
      {
       "code": "NT",
       "name": "Northern Territory"
      },
      {
       "code": "JBT",
       "name": "Jervis Bay Territory"
      },
      {
       "code": "NFI",
       "name": "Norfolk Island"
      },
      {
       "code": "CI",
       "name": "Christmas Island"
      },
      {
       "code": "CKI",
       "name": "Cocos (Keeling) Islands"
      },
      {
       "code": "ACI",
       "name": "Ashmore and Cartier Islands"
      },
      {
       "code": "CSI",
       "name": "Coral Sea Islands"
      },
      {
       "code": "HMI",
       "name": "Heard and McDonald Islands"
      },
      {
       "code": "AAT",
       "name": "Australian Antarctic Territory"
      },
      {
       "code": "CMA",
       "name": "Commonwealth marine area"
      }
     ]
    },
    "key": "code",
    "fields": [
     "name"
    ]
   },
   "as": [
    "Region"
   ]
  },
  {
   "calculate": "datum.Count == 0 ? '–' : '' + datum.Count",
   "as": "Label"
  }
 ],
 "encoding": {
  "x": {
   "field": "Status",
   "type": "ordinal",
   "sort": [
    "Extinct",
    "Extinct in the wild",
    "Critically Endangered",
    "Endangered",
    "Vulnerable",
    "Conservation Dependent"
   ],
   "axis": {
    "orient": "top",
    "title": null,
    "ticks": false,
    "domain": false,
    "labelAngle": 0,
    "labelPadding": 24,
    "labelFontSize": 11,
    "labelFontWeight": "bold",
    "labelColor": "#374151",
    "labelExpr": "datum.label == 'Extinct in the wild' ? ['Extinct in','the wild'] : datum.label == 'Critically Endangered' ? ['Critically','endangered'] : datum.label == 'Conservation Dependent' ? ['Conservation','dependent'] : datum.label == 'Endangered' ? 'Endangered' : datum.label",
    "labelBaseline": "middle",
    "labelLineHeight": 13
   }
  },
  "y": {
   "field": "Region",
   "type": "ordinal",
   "sort": [
    "New South Wales",
    "Victoria",
    "Queensland",
    "Western Australia",
    "South Australia",
    "Tasmania",
    "Australian Capital Territory",
    "Northern Territory",
    "Jervis Bay Territory",
    "Norfolk Island",
    "Christmas Island",
    "Cocos (Keeling) Islands",
    "Ashmore and Cartier Islands",
    "Coral Sea Islands",
    "Heard and McDonald Islands",
    "Australian Antarctic Territory",
    "Commonwealth marine area"
   ],
   "axis": {
    "title": null,
    "ticks": false,
    "domain": false,
    "labelFontSize": 11,
    "labelColor": "#374151",
    "labelLimit": 200,
    "labelPadding": 8,
    "labelExpr": "datum.label == 'Australian Capital Territory' ? 'ACT' : datum.label"
   }
  }
 },
 "layer": [
  {
   "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2
   },
   "encoding": {
    "color": {
     "field": "Count",
     "type": "quantitative",
     "scale": {
      "type": "sqrt",
      "scheme": "oranges"
     },
     "legend": {
      "title": "Number of species",
      "orient": "none",
      "direction": "horizontal",
      "legendX": {
       "expr": "width/2 - 150"
      },
      "legendY": {
       "expr": "height + 14"
      },
      "gradientLength": 300,
      "gradientThickness": 12,
      "titleOrient": "top",
      "titleAnchor": "middle",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titlePadding": 6,
      "labelFontSize": 11,
      "labelOverlap": true,
      "values": [
       0,
       25,
       50,
       75,
       100
      ]
     }
    },
    "tooltip": [
     {
      "field": "Region",
      "type": "nominal",
      "title": "State or territory"
     },
     {
      "field": "Status",
      "type": "nominal",
      "title": "Status"
     },
     {
      "field": "Count",
      "type": "quantitative",
      "title": "Species"
     }
    ]
   }
  },
  {
   "mark": {
    "type": "text",
    "fontSize": 12
   },
   "encoding": {
    "text": {
     "field": "Label",
     "type": "nominal"
    },
    "color": {
     "condition": {
      "test": "datum.Count > 45",
      "value": "white"
     },
     "value": "#374151"
    }
   }
  }
 ],
 "config": {
  "view": {
   "stroke": null
  },
  "font": "Helvetica Neue, Arial, sans-serif"
 },
 "autosize": {
  "type": "fit-x",
  "contains": "padding"
 }
}